{
  "name": "hcfy-refactored",
  "version": "1.1.0",
  "license": "GPL-3.0",
  "private": true,
  "description": "无登翻译 (MV3 Extension)",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:firefox": "node scripts/build.mjs --target=firefox",
    "build:all": "node scripts/build.mjs --target=all",
    "watch": "node scripts/build.mjs --watch",
    "watch:firefox": "node scripts/build.mjs --target=firefox --watch",
    "pack": "node scripts/pack.mjs",
    "pack:firefox": "node scripts/pack.mjs --target=firefox",
    "pack:all": "node scripts/pack.mjs --target=all",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,css}\""
  },
  "dependencies": {
    "@blueprintjs/core": "^6.23.2",
    "@blueprintjs/icons": "^6.17.0",
    "@blueprintjs/select": "^6.4.4",
    "classnames": "^2.5.1",
    "debug": "^4.3.7",
    "dexie": "^4.0.10",
    "dompurify": "^3.3.1",
    "eventemitter3": "^5.0.1",
    "fast-deep-equal": "^3.1.3",
    "immer": "^10.1.1",
    "ky": "^1.7.5",
    "lodash": "^4.17.21",
    "nanoid": "^5.0.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-popper": "^2.3.0",
    "react-shadow": "^20.6.0",
    "react-use": "^17.6.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.1",
    "esbuild": "^0.25.0",
    "prettier": "^3.4.2"
  }
}
